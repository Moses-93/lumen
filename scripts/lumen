#!/bin/bash

SCRIPT_PATH=$(readlink -f "$0")
PROJECT_ROOT=$(dirname "$(dirname "$SCRIPT_PATH")")

ENV_FILE="$PROJECT_ROOT/.env"
COMPOSE_FILE="$PROJECT_ROOT/docker/docker-compose-dev.yaml"

USE_GPU=$(grep "^USE_GPU=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d '[:space:]')

CLI_SERVICE="cli-cpu"
[[ "$USE_GPU" == "true" ]] && CLI_SERVICE="cli-gpu"

docker compose \
    -f "$COMPOSE_FILE" \
    --env-file "$ENV_FILE" \
    exec "$CLI_SERVICE" \
    lumen "$@"